{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garvitpahal-com",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  // Disable workers.dev URL as they would bypass Cloudflare Access.
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
}
