{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garvitpahal-com",
  "compatibility_date": "2026-04-15",
  // `enable_request_signal`: `request.signal` fires when the browser drops an extraction stream, so
  // the hedged model calls behind it can be cut off.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  // Disable workers.dev URL as they would bypass Cloudflare Access.
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
}
