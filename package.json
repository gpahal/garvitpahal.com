{
  "private": true,
  "name": "garvitpahal.com",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "generate-color-theme": "tsx scripts/generate-color-theme.ts",
    "prepare": "simple-git-hooks",
    "pre-push": "run-p type-check lint fmt-check && astro check",
    "astro": "astro",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "type-check": "tsc --noEmit",
    "lint": "run-s lint:*",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.css\"",
    "lint-fix": "run-s lint-fix:*",
    "lint-fix:eslint": "eslint . --fix",
    "lint-fix:stylelint": "stylelint \"src/**/*.css\" --fix",
    "fmt": "prettier \"**/*.{astro,js,mjs,cjs,jsx,ts,tsx,css,json}\" --write",
    "fmt-check": "prettier \"**/*.{astro,js,mjs,cjs,jsx,ts,tsx,css,json}\" --check"
  },
  "remarkConfig": {
    "plugins": [
      "@gpahal/remark-preset-lint"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@gpahal/eslint-config": "^0.0.127",
    "@gpahal/prettier-config": "^0.0.34",
    "@gpahal/remark-preset-lint": "^0.0.4",
    "@gpahal/std": "^0.0.42",
    "@gpahal/stylelint-config": "^0.0.20",
    "@gpahal/tailwindcss-color-themes": "^0.0.41",
    "@gpahal/tailwindcss-variants": "^0.0.29",
    "@gpahal/tsconfig": "^0.0.20",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.9",
    "astro": "^5.16.12",
    "astro-expressive-code": "^0.41.6",
    "cssnano": "^7.1.2",
    "date-fns": "^4.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "npm-run-all2": "^8.0.4",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.1.1",
    "prettier": "^3.8.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "remark-cli": "^12.0.1",
    "rimraf": "^6.1.2",
    "sharp": "^0.34.5",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
