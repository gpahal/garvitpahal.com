{
  "private": true,
  "name": "garvitpahal.com",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "generate-color-theme": "tsx scripts/generate-color-theme.ts",
    "prepare": "simple-git-hooks",
    "pre-push": "run-p type-check lint fmt-check && astro check",
    "astro": "astro",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "type-check": "tsc --noEmit",
    "lint": "run-s lint:*",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.css\"",
    "lint-fix": "run-s lint-fix:*",
    "lint-fix:eslint": "eslint . --fix",
    "lint-fix:stylelint": "stylelint \"src/**/*.css\" --fix",
    "fmt": "prettier \"**/*.{astro,js,mjs,cjs,jsx,ts,tsx,css,json}\" --write",
    "fmt-check": "prettier \"**/*.{astro,js,mjs,cjs,jsx,ts,tsx,css,json}\" --check"
  },
  "remarkConfig": {
    "plugins": [
      "@gpahal/remark-preset-lint"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@gpahal/eslint-config": "^0.0.128",
    "@gpahal/prettier-config": "^0.0.35",
    "@gpahal/remark-preset-lint": "^0.0.5",
    "@gpahal/std": "^0.0.43",
    "@gpahal/stylelint-config": "^0.0.20",
    "@gpahal/tailwindcss-color-themes": "^0.0.43",
    "@gpahal/tailwindcss-variants": "^0.0.30",
    "@gpahal/tsconfig": "^0.0.20",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.6.0",
    "astro": "^6.1.5",
    "astro-expressive-code": "^0.41.7",
    "cssnano": "^7.1.4",
    "date-fns": "^4.1.0",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^1.7.0",
    "npm-run-all2": "^8.0.4",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.2.0",
    "prettier": "^3.8.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "remark-cli": "^12.0.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.6.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
