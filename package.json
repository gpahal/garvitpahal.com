{
  "name": "garvitpahal.com",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "run-s sync check:all",
    "check:all": "run-p typecheck:* lint fmt-check test",
    "convex-dev": "convex dev --env-file .env.development",
    "convex-dev-set-env": "infisical run --env=dev --silent -- node --env-file=.env.development scripts/convex-env.ts",
    "convex-guidelines": "node scripts/convex-guidelines.ts",
    "convex-jwt-key": "node scripts/convex-jwt-key.ts",
    "dev": "CLOUDFLARE_ENV=dev infisical run --env=dev --silent -- astro dev",
    "dev:public": "astro dev",
    "fmt": "prettier . --write",
    "fmt-check": "prettier . --check",
    "lint": "run-p lint:*",
    "lint:eslint": "eslint .",
    "lint:links": "remark . --quiet --frail --no-stdout --ignore-path .gitignore --ignore-pattern convex/_generated --use remark-validate-links=repository:false",
    "lint:stylelint": "stylelint --allow-empty-input --ignore-path .gitignore \"**/*.{css,astro,html,md,markdown}\"",
    "lint-fix": "run-s lint-fix:*",
    "lint-fix:eslint": "eslint . --fix",
    "lint-fix:stylelint": "pnpm lint:stylelint --fix",
    "og-card": "node scripts/og-card.ts",
    "preview": "astro preview",
    "resume": "RESUME_PRINT=1 astro build && node scripts/resume-pdf.ts",
    "sync": "astro sync",
    "test": "vitest run",
    "typecheck:app": "astro check --noSync",
    "typecheck:convex": "tsc -p convex"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/markdown-satteri": "^0.4.5",
    "@astrojs/react": "^7.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@base-ui/react": "^1.9.0",
    "@convex-dev/action-retrier": "^0.3.1",
    "@convex-dev/aggregate": "^0.3.4",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@gpahal/eslint-config": "^0.0.145",
    "@gpahal/prettier-config": "^0.0.48",
    "@gpahal/stylelint-config": "^0.0.29",
    "@gpahal/tsconfig": "^0.0.24",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "astro": "^7.4.2",
    "astro-expressive-code": "^0.44.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "convex": "^1.48.0",
    "convex-helpers": "^0.1.129",
    "convex-test": "^0.0.66",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-slop": "^0.1.3",
    "jose": "^6.2.13",
    "lucide-react": "^1.63.0",
    "npm-run-all2": "^9.0.4",
    "openai": "^7.45.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "satteri": "^0.11.5",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=24.22.0"
  }
}
