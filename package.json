{
  "private": true,
  "name": "garvitpahal.com",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "generate-color-theme": "tsx scripts/generate-color-theme.ts",
    "prepare": "simple-git-hooks",
    "pre-push": "run-p typecheck lint fmt-check && astro check",
    "astro": "astro",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "lint": "run-s lint:*",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.css\"",
    "lint-fix": "run-s lint-fix:*",
    "lint-fix:eslint": "eslint . --fix",
    "lint-fix:stylelint": "stylelint \"src/**/*.css\" --fix",
    "fmt": "prettier \"**/*.{astro,js,mjs,cjs,jsx,ts,tsx,css,json}\" --write",
    "fmt-check": "prettier \"**/*.{astro,js,mjs,cjs,jsx,ts,tsx,css,json}\" --check"
  },
  "remarkConfig": {
    "plugins": [
      "@gpahal/remark-preset-lint"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@base-ui/react": "^1.8.0",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/css": "^2.0.0",
    "@gpahal/eslint-config": "^0.0.132",
    "@gpahal/prettier-config": "^0.0.39",
    "@gpahal/remark-preset-lint": "^0.0.6",
    "@gpahal/std": "^0.0.45",
    "@gpahal/stylelint-config": "^0.0.24",
    "@gpahal/tailwindcss-color-themes": "^0.0.45",
    "@gpahal/tailwindcss-variants": "^0.0.33",
    "@gpahal/tsconfig": "^0.0.21",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.2",
    "astro-expressive-code": "^0.44.2",
    "cssnano": "^9.0.4",
    "date-fns": "^4.4.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "npm-run-all2": "^9.0.3",
    "openai": "^7.15.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.5.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-cli": "^12.0.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.4",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.15.0",
    "tailwind-csstree": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.2",
    "zod": "^4.6.5"
  }
}
