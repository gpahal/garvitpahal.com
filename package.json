{
  "name": "garvitpahal.com",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "run-s sync check:all",
    "check:all": "run-p typecheck:* lint fmt-check test",
    "convex-dev": "convex dev --env-file .env.development",
    "convex-dev-set-env": "infisical run --env=dev --silent -- node --env-file=.env.development scripts/convex-env.ts",
    "convex-guidelines": "node scripts/convex-guidelines.ts",
    "convex-jwt-key": "node scripts/convex-jwt-key.ts",
    "dev": "CLOUDFLARE_ENV=dev infisical run --env=dev --silent -- astro dev",
    "dev:public": "astro dev",
    "fmt": "prettier . --write",
    "fmt-check": "prettier . --check",
    "lint": "run-p lint:*",
    "lint:eslint": "eslint .",
    "lint:links": "remark . --quiet --frail --no-stdout --ignore-path .gitignore --ignore-pattern convex/_generated --use remark-validate-links=repository:false",
    "lint:stylelint": "stylelint --allow-empty-input --ignore-path .gitignore \"**/*.{css,astro,html,md,markdown}\"",
    "lint-fix": "run-s lint-fix:*",
    "lint-fix:eslint": "eslint . --fix",
    "lint-fix:stylelint": "pnpm lint:stylelint --fix",
    "og-card": "node scripts/og-card.ts",
    "preview": "astro preview",
    "resume": "RESUME_PRINT=1 astro build && node scripts/resume-pdf.ts",
    "sync": "astro sync",
    "test": "vitest run",
    "typecheck:app": "astro check --noSync",
    "typecheck:convex": "tsc -p convex"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@base-ui/react": "^1.9.0",
    "@convex-dev/action-retrier": "^0.3.1",
    "@convex-dev/aggregate": "^0.3.4",
    "@convex-dev/rate-limiter": "^0.4.3",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@gpahal/eslint-config": "^0.0.148",
    "@gpahal/prettier-config": "^0.0.51",
    "@gpahal/stylelint-config": "^0.0.32",
    "@gpahal/tsconfig": "^0.0.25",
    "@openrouter/sdk": "^1.5.117",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "astro": "^7.4.13",
    "astro-expressive-code": "^0.44.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "convex": "^1.51.0",
    "convex-helpers": "^0.1.136",
    "convex-test": "^0.0.73",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-slop": "^0.1.3",
    "jose": "^6.2.18",
    "lucide-react": "^1.75.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "satteri": "^0.11.7",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "stylelint": "^18.0.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=24.22.0"
  }
}
