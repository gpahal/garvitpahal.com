{
  "private": true,
  "name": "garvitpahal.com",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "generate-color-theme": "tsx scripts/generate-color-theme.ts",
    "prepare": "simple-git-hooks",
    "pre-push": "run-p typecheck lint fmt-check && astro check",
    "astro": "astro",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "lint": "run-s lint:*",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.css\"",
    "lint-fix": "run-s lint-fix:*",
    "lint-fix:eslint": "eslint . --fix",
    "lint-fix:stylelint": "stylelint \"src/**/*.css\" --fix",
    "fmt": "prettier \"**/*.{astro,js,mjs,cjs,jsx,ts,tsx,css,json}\" --write",
    "fmt-check": "prettier \"**/*.{astro,js,mjs,cjs,jsx,ts,tsx,css,json}\" --check"
  },
  "remarkConfig": {
    "plugins": [
      "@gpahal/remark-preset-lint"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@base-ui/react": "^1.6.0",
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/css": "^1.4.0",
    "@gpahal/eslint-config": "^0.0.131",
    "@gpahal/prettier-config": "^0.0.38",
    "@gpahal/remark-preset-lint": "^0.0.5",
    "@gpahal/std": "^0.0.44",
    "@gpahal/stylelint-config": "^0.0.22",
    "@gpahal/tailwindcss-color-themes": "^0.0.44",
    "@gpahal/tailwindcss-variants": "^0.0.33",
    "@gpahal/tsconfig": "^0.0.21",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.5",
    "astro-expressive-code": "^0.44.1",
    "cssnano": "^8.0.2",
    "date-fns": "^4.4.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "npm-run-all2": "^9.0.3",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.3.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-cli": "^12.0.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.3",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.1",
    "tailwind-csstree": "^0.3.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.115.0",
    "zod": "^4.4.3"
  }
}
