---
import Layout from '@/layouts/layout.astro'
import H1 from '@/components/heading/h1.astro'
import { PuzzleWorkspace } from '@/components/x/workspace/puzzle-workspace'
import { listPuzzles, type PuzzleId } from '@/puzzles/registry'

export async function getStaticPaths() {
  return listPuzzles().map((puzzle) => ({
    params: { puzzle: puzzle.id },
    props: { id: puzzle.id as PuzzleId, name: puzzle.name, blurb: puzzle.blurb },
  }))
}

type Props = {
  id: PuzzleId
  name: string
  blurb: string
}

const { id, name, blurb } = Astro.props

const title = `${name} solver`
---

<Layout title={title} noindex>
  <header>
    <H1 class="mb-1!">{title}</H1>
    <p class="text-gray-11 mt-0! mb-6! text-base">{blurb}</p>
  </header>

  <PuzzleWorkspace puzzleId={id} client:load />
</Layout>
