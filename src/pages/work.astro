---
import { getCollection, getEntry } from 'astro:content'

import { formatYearRange } from '@/lib/dates'
import Layout from '@/layouts/layout.astro'
import { ButtonLink } from '@/components/shared/button-link'
import PageHeader from '@/components/shared/page-header.astro'
import Timeline from '@/components/shared/timeline.astro'
import { A, H2, H3, Muted, P, Ul } from '@/components/shared/typography'

const workExperiences = await getCollection('workExperiences')
const notablePersonalProjects = await getCollection('notablePersonalProjects')
const projectPageIds = new Set((await getCollection('projectPages')).map(({ id }) => id))
const profile = await getEntry('resume', 'profile')
if (profile === undefined) {
  throw new Error("Missing content entry 'resume/profile'")
}
const { education, awards } = profile.data
const years = formatYearRange(education.startedOn, education.endedOn)
---

<Layout
  title="Work"
  description="Where Garvit Pahal has worked since 2015, mostly at early-stage startups, and the personal projects he is proudest of"
>
  <PageHeader title="Work" />

  <P>
    Ten years at early-stage startups, mostly as a founding engineer. Smaller projects are on{' '}
    <A href="/projects">projects</A>.
  </P>

  <div class="mt-8 flex items-center justify-between gap-4">
    <H2>Work experiences</H2>
    <ButtonLink variant="outline" size="sm" href="/docs/resume.pdf" isFile>
      View resume
    </ButtonLink>
  </div>
  <Timeline
    items={workExperiences.map((entry) => ({
      entry,
      heading: entry.data.company,
      href: entry.data.href,
      role: entry.data.role,
    }))}
  />

  <H2>Notable personal projects</H2>
  <Timeline
    items={notablePersonalProjects.map((entry) => ({
      entry,
      heading: entry.data.project,
      href: projectPageIds.has(entry.id) ? `/projects/${entry.id}` : entry.data.href,
    }))}
  />

  <H2>Education</H2>
  <H3 className="mt-6">{education.school}</H3>
  <Muted className="mt-1">{`${education.degree}, ${years}`}</Muted>
  {education.notes !== undefined && <P>{education.notes}</P>}
  <Ul>
    {awards.map((award) => (
      <li>{award}</li>
    ))}
  </Ul>
</Layout>
