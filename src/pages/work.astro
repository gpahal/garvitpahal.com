---
import { getCollection } from 'astro:content'

import Layout from '@/layouts/layout.astro'
import { ButtonLink } from '@/components/shared/button-link'
import PageHeader from '@/components/shared/page-header.astro'
import Timeline from '@/components/shared/timeline.astro'
import { A, H2, P } from '@/components/shared/typography'

const workExperiences = await getCollection('workExperiences')
const notablePersonalProjects = await getCollection('notablePersonalProjects')
---

<Layout
  title="Work"
  description="Where Garvit Pahal has worked in tech since 2015, and the personal projects he is proudest of"
>
  <PageHeader title="Work" />

  <P>
    I've worked in the tech industry since 2015. The initial years were a rollercoaster: I founded a
    startup and worked for a graph database company and a high-frequency trading firm. I found that
    building products that people use every day is the most motivating thing for me.
  </P>
  <P>
    Apart from my day jobs (listed below), I work on a few <A href="/projects">side projects</A>{' '}
    from time to time. A few recent ones that I'm proud of are{' '}
    <A href="https://github.com/gpahal/pdf-rag-embed-bench">pdf-rag-embed-bench</A>,{' '}
    <A href="https://github.com/gpahal/microgpt">microgpt</A>,{' '}
    <A href="https://github.com/gpahal/durable-execution">durable-execution</A> and{' '}
    <A href="https://superstream.finance/">Superstream</A>.
  </P>

  <div class="mt-8 flex items-center justify-between gap-4">
    <H2>Work experiences</H2>
    <ButtonLink variant="outline" size="sm" href="/docs/resume.pdf" isFile>
      View resume
    </ButtonLink>
  </div>
  <Timeline
    items={workExperiences.map((entry) => ({
      entry,
      heading: entry.data.company,
      role: entry.data.role,
    }))}
  />

  <H2>Notable personal projects</H2>
  <Timeline
    items={notablePersonalProjects.map((entry) => ({ entry, heading: entry.data.project }))}
  />
</Layout>
