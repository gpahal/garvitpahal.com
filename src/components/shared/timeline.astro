---
import { render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

import { formatPeriods, formatYearRange, periodsOf, sortNewestFirst } from '@/lib/dates'
import { A, H3, Muted } from '@/components/shared/typography'

type Props = {
  items: Array<{
    entry: CollectionEntry<'workExperiences' | 'notablePersonalProjects'>
    heading: string
    href?: string
    role?: string
  }>
}

const items = await Promise.all(
  sortNewestFirst(Astro.props.items, ({ entry }) => ({
    date: entry.data.startedOn,
    id: entry.id,
  })).map(async (item) => ({ ...item, Content: (await render(item.entry)).Content })),
)
---

{/* eslint-disable-next-line astro/jsx-a11y/no-redundant-roles -- WebKit drops a list role under list-style: none */}
<ul role="list" class="mt-6 flex flex-col gap-10">
  {items.map(({ entry, heading, href, role, Content }) => (
    <li>
      <H3>
        {href === undefined ? (
          heading
        ) : (
          <A href={href} className="text-foreground">
            {heading}
          </A>
        )}
      </H3>
      <Muted className="mt-1">
        {role !== undefined ? `${role}, ` : ''}
        {/* Projects' months are approximate, so they show years. */}
        {entry.collection === 'notablePersonalProjects'
          ? formatYearRange(entry.data.startedOn, entry.data.endedOn)
          : formatPeriods(periodsOf(entry.data))}
      </Muted>
      <Content />
    </li>
  ))}
</ul>
