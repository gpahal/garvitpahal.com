---
import { render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

import { formatMonthRange, sortNewestFirst } from '@/lib/dates'
import { mdxComponents } from '@/components/shared/mdx-components'
import { H3, Muted } from '@/components/shared/typography'

type Props = {
  items: Array<{
    entry: CollectionEntry<'workExperiences' | 'notablePersonalProjects'>
    heading: string
    role?: string
  }>
}

const items = await Promise.all(
  sortNewestFirst(Astro.props.items, ({ entry }) => ({
    date: entry.data.startedOn,
    id: entry.id,
  })).map(async (item) => ({ ...item, Content: (await render(item.entry)).Content })),
)
---

{/* eslint-disable-next-line astro/jsx-a11y/no-redundant-roles -- WebKit drops a list role under list-style: none */}
<ul role="list" class="mt-6 flex flex-col gap-10">
  {items.map(({ entry, heading, role, Content }) => (
    <li>
      <H3>{heading}</H3>
      <Muted className="mt-1">
        {role !== undefined ? `${role}, ` : ''}
        {formatMonthRange(entry.data.startedOn, entry.data.endedOn)}
      </Muted>
      <Content components={mdxComponents} />
    </li>
  ))}
</ul>
