---
import { getImage } from 'astro:assets'
import { PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN } from 'astro:env/client'
import { ClientRouter } from 'astro:transitions'

import { dateOnlyToUtc } from '@/lib/dates'
import type { DateOnly } from '@/lib/dates'
import { BLOG_FEED_TITLE, isPrivatePath, isUnlistedPath, SITE_NAME, SITE_TAGLINE } from '@/lib/site'
import { WEB_ANALYTICS_BEACON } from '@/lib/web-analytics'
import Nav from '@/components/nav/index.astro'
import IslandFailure from '@/components/shared/island-failure.astro'
import satoshi from '@/assets/fonts/satoshi/variable.woff2?url'

import '@/styles/global.css'

type Props = {
  title?: string
  description?: string
  isFullPage?: boolean
  /**
   * Serialised JSON-LD for the head, escaped so it cannot close its script element.
   */
  jsonLd?: string
  article?: {
    headline: string
    publishedTime: DateOnly
    tags?: Array<string>
  }
  /**
   * What a shared link shows instead of the site's card.
   */
  image?: { src: ImageMetadata; alt: string }
}

const {
  title: titleProp,
  description: descriptionProp,
  isFullPage,
  jsonLd,
  article,
  image: imageProp,
} = Astro.props
const url = new URL(Astro.url.pathname, Astro.site)
/**
 * JPEG, not Astro's default WebP, which some link previews cannot show. Never enlarged.
 */
const shareImage =
  imageProp === undefined
    ? {
        src: '/images/og-card.png',
        type: 'image/png',
        width: 1200,
        height: 630,
        alt: `${SITE_NAME}: ${SITE_TAGLINE}`,
      }
    : await getImage({
        src: imageProp.src,
        width: Math.min(imageProp.src.width, 1200),
        format: 'jpg',
      }).then((image) => ({
        src: image.src,
        type: 'image/jpeg',
        width: Number(image.attributes.width),
        height: Number(image.attributes.height),
        alt: imageProp.alt,
      }))
const imageUrl = new URL(shareImage.src, Astro.site)

const title = titleProp === undefined ? SITE_NAME : `${titleProp} | ${SITE_NAME}`
const description = descriptionProp ?? SITE_TAGLINE
const isUnlisted = isUnlistedPath(Astro.url.pathname)
/**
 * `/nav` and `/404` are unlisted but not private: their links are the site's own.
 */
const robots = isPrivatePath(Astro.url.pathname)
  ? 'noindex, nofollow'
  : isUnlisted
    ? 'noindex, follow'
    : 'index, follow'
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* A dark OS gets a dark canvas before the stylesheet arrives, so it never sees a white flash. */}
    <meta name="color-scheme" content="light dark" />
    {/*
     * `--background` in `global.css` resolved to sRGB, so the browser's bar meets the page with no
     * seam. The manifest takes one colour, so it carries the light one.
     */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0a09" />
    {/* Otherwise found only once the stylesheet is parsed, and the first paint swaps fonts. */}
    <link rel="preload" as="font" type="font/woff2" href={satoshi} crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <link rel="manifest" href="/site.webmanifest" />

    {/*
     * Unlisted pages get no canonical or `og:url`: `/404` is served at every missing path.
     */}
    {!isUnlisted && <link rel="canonical" href={url} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    <link rel="author" href={Astro.site} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={article?.headline ?? titleProp ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    {!isUnlisted && <meta property="og:url" content={url} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content={shareImage.type} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={shareImage.alt} />
    {article && (
      <>
        <meta property="article:author" content={Astro.site} />
        <meta
          property="article:published_time"
          content={dateOnlyToUtc(article.publishedTime).toISOString()}
        />
        {article.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@g10pahal" />

    <meta name="robots" content={robots} />
    {/* eslint-disable-next-line astro/no-set-html-directive -- JSON-LD must be raw JSON, escaped by its builder */}
    {jsonLd !== undefined && <script type="application/ld+json" is:inline set:html={jsonLd} />}

    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={BLOG_FEED_TITLE} href="/blog.rss.xml" />

    {/*
     * Site-wide so every navigation animates, and so Agenda's `transition:persist` root survives.
     */}
    <ClientRouter />
    {/*
     * In the head, identical on every public page, so `<ClientRouter />` keeps it across
     * navigations; the beacon reports each route change itself. Built public pages only, so neither
     * dev nor the owner's `/x` visits are counted.
     */}
    {import.meta.env.PROD &&
      !isPrivatePath(Astro.url.pathname) &&
      PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN !== undefined &&
      PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN !== '' && (
        <script
          is:inline
          defer
          src={WEB_ANALYTICS_BEACON}
          data-cf-beacon={JSON.stringify({ token: PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN })}
        />
      )}
    <script>
      import { isPrivatePath } from '@/lib/site'

      // A beacon started on a public page would report the `/x` routes the router swaps in, so
      // crossing between the two takes a full load. Back and Forward included.
      document.addEventListener('astro:before-preparation', (event) => {
        if (isPrivatePath(event.from.pathname) !== isPrivatePath(event.to.pathname)) {
          event.preventDefault()
        }
      })
    </script>
  </head>
  <body>
    <IslandFailure />
    {!isFullPage && (
      <a
        href="#main"
        class="sr-only rounded-lg bg-background px-4 py-2 font-medium text-foreground outline-2 outline-offset-2 outline-muted-foreground focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-20"
      >
        Skip to content
      </a>
    )}
    <Nav isFullPage={isFullPage} />
    {!isFullPage && (
      <div class="lg:ml-70 lg:px-20 xl:px-44">
        {/*
         * `tabindex="-1"`: without it the fragment moves the scroll but not the focus.
         */}
        <main
          id="main"
          tabindex="-1"
          class="mx-auto w-full max-w-xl px-6 pt-6 pb-24 outline-none lg:mx-0 lg:pb-6 print:pb-0"
        >
          <slot />
        </main>
      </div>
    )}
  </body>
</html>
